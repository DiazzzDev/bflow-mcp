PORT=8081

# Same Cognito user pool BFlow's API uses. bflow-mcp only validates
# tokens against this issuer — it never mints its own (ADR-0010 §2-3).
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool-id

# The BFlow API this instance proxies to. Point at your local
# BFlow-Financial-Engine (http://host.docker.internal:8080) while
# developing tools, or the deployed dev API otherwise.
BFLOW_API_BASE_URL=http://host.docker.internal:8080

# --- DCR shim ---

# Signs this service's own JWTs (client_id tokens, outer-state tokens —
# ProxyTokenCodec). Own secret, never reused from Cognito. At least 32
# bytes for HS256. Generate a real one for prod with:
#   openssl rand -base64 32
BFLOW_MCP_PROXY_SIGNING_SECRET=dev-only-signing-secret-at-least-32-bytes-long

# Comma-separated, exact-match redirect URIs POST /oauth/register is
# allowed to issue a client_id for (RedirectUriAllowlist).
BFLOW_MCP_PROXY_ALLOWED_REDIRECT_URIS=http://127.0.0.1:6274/oauth/callback,https://chatgpt.com/connector_platform_oauth_redirect,https://claude.ai/api/mcp/auth_callback

# The real, static Cognito App Client id (bflow-mcp-agent-client) every
# DCR client_id maps to.
COGNITO_APP_CLIENT_ID=your-cognito-app-client-id