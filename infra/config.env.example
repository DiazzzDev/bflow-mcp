# bflow-mcp shares BFlow-Financial-Engine's ECS cluster, VPC, and
# security group (ADR-0009/0010) — but it's a separate repo, so it
# can't reach into that repo's infra/outputs.env on disk. Copy these
# handful of values over by hand from `BFlow-Financial-Engine/infra/outputs.env`
# after that repo's infra is bootstrapped, instead.

PROJECT_NAME=bflow-mcp
ENVIRONMENT=production
MANAGED_BY=github-actions

AWS_REGION=us-east-1

# From BFlow-Financial-Engine/infra/outputs.env — same cluster/VPC, no
# new cluster for bflow-mcp (ADR-0009 §1).
ECS_CLUSTER_NAME=
ECS_CLUSTER_ARN=
ECS_PUBLIC_SUBNET_1=
ECS_PUBLIC_SUBNET_2=
ECS_SECURITY_GROUP=

# This repo's own GitHub coordinates, for the OIDC trust policy.
GITHUB_OWNER=DiazzzDev
GITHUB_REPOSITORY=bflow-mcp
