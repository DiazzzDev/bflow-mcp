# Copy to imports.local.tf (ignored by Git) and adjust names/ids from AWS CLI
# discovery. Import blocks record existing resources in state without changing
# AWS. Run `./deploy.sh plan` and apply only when the plan is a no-op or holds
# intentional drift fixes.

import {
  to = aws_ecr_repository.mcp
  id = "bflow-mcp"
}

import {
  to = aws_cloudwatch_log_group.mcp
  id = "/ecs/bflow-mcp"
}

import {
  to = aws_iam_role.ecs_execution
  id = "bflow-mcp-ecs-execution-role"
}

import {
  to = aws_iam_role_policy_attachment.ecs_execution_managed
  id = "bflow-mcp-ecs-execution-role/arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

import {
  to = aws_iam_role.ecs_task
  id = "bflow-mcp-ecs-task-role"
}

import {
  to = aws_iam_role.github_actions
  id = "bflow-mcp-github-actions-role"
}

import {
  to = aws_iam_role_policy.github_actions_deploy
  id = "bflow-mcp-github-actions-role:bflow-mcp-github-deploy-policy"
}

