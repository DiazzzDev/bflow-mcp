CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
# The A record for mcp.bflow-studio.com must already exist in Cloudflare
# (any placeholder IP is fine) — this script only updates it, it
# doesn't create it.
CLOUDFLARE_DNS_RECORD_ID=your-dns-record-id
CLOUDFLARE_DNS_RECORD_NAME=mcp.bflow-studio.com
